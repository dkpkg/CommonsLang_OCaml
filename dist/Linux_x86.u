# Distribution for Linux x86 CommonsLang_OCaml

## DkML

  $ get-object CommonsLang_OCaml.DkML@4.14.3001 -s Release.Linux_x86 -d ${RUNTIME}/Linux_x86-DkML-4.14.3
  \test(pass)
  \dk.object(abi: "Release.Linux_x86", value-id: "oqeb7jorj5bljnckopyrptishs4s6tiqltuykdigfqda4yol2hogq")\;

  $ run-object CommonsBase_FileMagic.File@7.8.50407 -s Release.execution_abi -m ./bin/file.exe -e bin/file.exe --
  >   -b $(get-object CommonsLang_OCaml.DkML@4.14.3001 -s Release.target_abi -d : -e file.exe)/bin/ocamlopt
  \test(pass)
  \dk.target(abi: "Linux_x86")[ELF 32-bit LSB executable, Intel i386, version 1 (SYSV)
  ]\;

## Dune

  $ run-object CommonsLang_OCaml.Dune@3.23.2 -s Release.Linux_x86 -e 'bin/*' -c bin/dune.exe -- --version
  \test(pass)
  \dk.target(abi: "Linux_x86")[3.23.1
  ]\;

## Opam

  $ run-object CommonsLang_OCaml.Opam@2.5.2 -s Release.Linux_x86 -e 'bin/*' -c bin/opam.exe -- --version
  \test(pass)
  \dk.target(abi: "Linux_x86")[2.5.1
  ]\;

## Dk.OpamLock

Only the current OpamLock revision ships. The retired Export@1.0.0-@1.1.7
ladder lives in pre-2026-08 release tags and git history (see dk.u
"## Assets" for the keep-latest-only policy).

  $ run-function CommonsLang_OCaml.Dk.OpamLock.Export@1.1.22 -f ${RUNTIME}/OpamLock.Export-1.1.22.zip
  \test(pass)
  \dk.object(abi: "Release.Linux_x86_64", value-id: "onciw23mbjeycgelmtk6mqflnvyedww2llqemclmptdlit3dyhmcq")\;


## Dk.OpamBuild

Only the current OpamBuild revision ships. The retired Export@1.0.0-@1.0.15
ladder lives in pre-2026-08 release tags and git history (see dk.u
"## Assets" for the keep-latest-only policy).

  $ run-function CommonsLang_OCaml.Dk.OpamBuild.Export@1.0.29 -f ${RUNTIME}/OpamBuild.Export-1.0.29.zip
  \test(pass)
  \dk.object(abi: "Release.Linux_x86_64", value-id: "o2vpwyvntt4ufm6ongpqbd6wgoqzztry4r3x5ixyawn55s6ssya3q")\;
