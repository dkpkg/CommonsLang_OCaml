# Distribution for Linux x86 CommonsLang_OCaml

## DkML

  $ get-object CommonsLang_OCaml.DkML@4.14.3003 -s Release.Linux_x86 -d ${RUNTIME}/Linux_x86-DkML-4.14.3
  \test(pass)
  \dk.object(abi: "Release.Linux_x86", value-id: "owzv7fdo5y5nrwypo546uwtaafodcm4utwqy44sajveuj5bqpz4qa")\;

  $ get-object CommonsLang_OCaml.DkML@4.14.3002 -s Release.Linux_x86 -d ${RUNTIME}/Linux_x86-DkML-4.14.3002
  \test(pass)
  \dk.object(abi: "Release.Linux_x86", value-id: "o2nbnpkdn7rtmxsld6szq33a5gjw5ejjbxguoujvut3qydlnidopa")\;

  $ run-object CommonsBase_FileMagic.File@7.8.50407 -s Release.execution_abi -m ./bin/file.exe -e bin/file.exe --
  >   -b $(get-object CommonsLang_OCaml.DkML@4.14.3003 -s Release.target_abi -d : -e file.exe)/bin/ocamlopt
  \test(pass)
  \dk.target(abi: "Linux_x86")[ELF 32-bit LSB executable, Intel i386, version 1 (SYSV)
  ]\;

## DkMLStatic

On Linux_x86 DkMLStatic holds the DkML.Unix compiler that DkML holds.

  $ get-object CommonsLang_OCaml.DkMLStatic@4.14.3003 -s Release.Linux_x86 -d ${RUNTIME}/Linux_x86-DkMLStatic-4.14.3
  \test(pass)
  \dk.object(abi: "Release.Linux_x86", value-id: "ootxnaihi2u5sd2pdbplpt5jwk4zpctn4bplgwo5vb66hy355lb3q")\;

## Dune

  $ run-object CommonsLang_OCaml.Dune@3.23.4 -s Release.Linux_x86 -e 'bin/*' -c bin/dune.exe -- --version
  \test(pass)
  \dk.target(abi: "Linux_x86")[3.23.1
  ]\;

## Opam

  $ run-object CommonsLang_OCaml.Opam@2.5.4 -s Release.Linux_x86 -e 'bin/*' -c bin/opam.exe -- --version
  \test(pass)
  \dk.target(abi: "Linux_x86")[2.5.1
  ]\;

## Dk.OpamLock

Only the current OpamLock revision ships. The retired Export@1.0.0-@1.1.7
ladder lives in pre-2026-08 release tags and git history (see dk.u
"## Assets" for the keep-latest-only policy).

  $ run-function CommonsLang_OCaml.Dk.OpamLock.Export@1.1.28 -f ${RUNTIME}/OpamLock.Export-1.1.28.zip
  \test(pass)
  \dk.object(abi: "Release.Linux_x86_64", value-id: "o67wl53igg4aanhp2mk7rfz3x62dpgdqmyute2cthoxcdoxxmh32a")\;


## Dk.OpamBuild

Only the current OpamBuild revision ships. The retired Export@1.0.0-@1.0.15
ladder lives in pre-2026-08 release tags and git history (see dk.u
"## Assets" for the keep-latest-only policy).

  $ run-function CommonsLang_OCaml.Dk.OpamBuild.Export@1.0.33 -f ${RUNTIME}/OpamBuild.Export-1.0.33.zip
  \test(pass)
  \dk.object(abi: "Release.Linux_x86_64", value-id: "o2vpwyvntt4ufm6ongpqbd6wgoqzztry4r3x5ixyawn55s6ssya3q")\;
