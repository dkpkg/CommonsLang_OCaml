## Dk.OpamLock

  $ run-function CommonsLang_OCaml.Dk.OpamLock.Export@1.0.0 -f ${RUNTIME}/OpamLock.Export.zip
  \test(pass)
  \dk.object(abi: "Release.Linux_x86_64", value-id: "o7mmvaocrhvy765tkdtsbp76eyj2423m3espmw34kthkdoqvl3cdq")\;

The @1.1.0 revision ships alongside @1.0.0: its Solve rule delegates the lock
logic to a compiled OCaml helper (dk_opam_lock.ml + a vendored opam-file-format
amalgam), fixing the lua-ml depends-order scramble and the dropped
Linux_x86_64_musl slot. @1.1.0 is a fresh id, so it builds clean.

  $ run-function CommonsLang_OCaml.Dk.OpamLock.Export@1.1.0 -f ${RUNTIME}/OpamLock.Export-1.1.0.zip
  \test(pass)
  \dk.object(abi: "Release.Linux_x86_64", value-id: "ofot2gh6jlflllyw3fsfejr3zry2arpphivqbmi2sxjlbsuo724ka")\;
  $ run-function CommonsLang_OCaml.Dk.OpamLock.Export@1.1.1 -f ${RUNTIME}/OpamLock.Export-1.1.1.zip
  \test(pass)
  \dk.object(abi: "Release.Linux_x86_64", value-id: "oimllqf4c4qgwdywgchfppmedj2sgf53xn44mw5hi3foyb6hbus2a")\;
  $ run-function CommonsLang_OCaml.Dk.OpamLock.Export@1.1.3 -f ${RUNTIME}/OpamLock.Export-1.1.3.zip
  \test(pass)
  \dk.object(abi: "Release.Linux_x86_64", value-id: "o2i2aart5wgtdaokxyybpwnvgdgm6n2ic7bgtkiabsz7alyblcxia")\;
  $ run-function CommonsLang_OCaml.Dk.OpamLock.Export@1.1.4 -f ${RUNTIME}/OpamLock.Export-1.1.4.zip
  \test(pass)
  \dk.object(abi: "Release.Linux_x86_64", value-id: "oupyfttkspyjulfiy5kodvdlreesufidd6aplu6hiun4a3xksnqoa")\;
  $ run-function CommonsLang_OCaml.Dk.OpamLock.Export@1.1.5 -f ${RUNTIME}/OpamLock.Export-1.1.5.zip
  \test(pass)
  \dk.object(abi: "Release.Linux_x86_64", value-id: "o00000000000000000000000000000000000000000000000000000")\;


