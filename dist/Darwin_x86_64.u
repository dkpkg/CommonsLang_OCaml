# Distribution for Darwin x86_64 CommonsLang_OCaml

## DkML

  $ get-object CommonsLang_OCaml.DkML@4.14.3003 -s Release.Darwin_x86_64 -d ${RUNTIME}/Darwin_x86_64-DkML-4.14.3
  \test(pass)
  \dk.object(abi: "Release.Darwin_x86_64", value-id: "o3ohk3ukhbr5slqt7nozslcpvbbbdolqgssssj65fmg4d6m3xvasq")\;

  $ get-object CommonsLang_OCaml.DkML@4.14.3002 -s Release.Darwin_x86_64 -d ${RUNTIME}/Darwin_x86_64-DkML-4.14.3002
  \test(pass)

  $ run-object CommonsBase_FileMagic.File@7.8.50407 -s Release.execution_abi -m ./bin/file.exe -e bin/file.exe --
  >   -b $(get-object CommonsLang_OCaml.DkML@4.14.3003 -s Release.target_abi -d : -e file.exe)/bin/ocamlopt
  \test(pass)
  \dk.target(abi: "Darwin_x86_64")[Mach-O 64-bit executable, flags:<NOUNDEFS|DYLDLINK|TWOLEVEL|WEAK_DEFINES|BINDS_TO_WEAK|PIE>
  ]\;

## DkMLStatic

On Darwin_x86_64 DkMLStatic holds the DkML.Unix compiler that DkML holds.

  $ get-object CommonsLang_OCaml.DkMLStatic@4.14.3003 -s Release.Darwin_x86_64 -d ${RUNTIME}/Darwin_x86_64-DkMLStatic-4.14.3
  \test(pass)
  \dk.object(abi: "Release.Darwin_x86_64", value-id: "ozrzb4wi3ia6aem7hsvkfxjrvtqvd2km57v2dnh4couhtila2mhoq")\;

## Base

  $ run-object CommonsLang_OCaml.Base@5.5.0 -s Release.Darwin_x86_64 -e 'bin/*' -c bin/ocamlopt -- -version
  \test(pass)
  \dk.target(abi: "Darwin_x86_64")[5.5.0
  ]\;

## Dune

  $ run-object CommonsLang_OCaml.Dune@3.23.4 -s Release.Darwin_x86_64 -e 'bin/*' -c bin/dune.exe -- --version
  \test(pass)
  \dk.target(abi: "Darwin_x86_64")[3.23.1
  ]\;

## Opam

  $ run-object CommonsLang_OCaml.Opam@2.5.4 -s Release.Darwin_x86_64 -e 'bin/*' -c bin/opam.exe -- --version
  \test(pass)
  \dk.target(abi: "Darwin_x86_64")[2.5.1
  ]\;

## Dk.OpamLock

Only the current OpamLock revision ships. The retired Export@1.0.0-@1.1.7
ladder lives in pre-2026-08 release tags and git history (see dk.u
"## Assets" for the keep-latest-only policy).

  $ run-function CommonsLang_OCaml.Dk.OpamLock.Export@1.1.28 -f ${RUNTIME}/OpamLock.Export-1.1.28.zip
  \test(pass)
  \dk.object(abi: "Release.Darwin_arm64", value-id: "o73wmgqmhhx7zubdxx2rrhc5o2srzueaoif6e6yzx6aiqb3rp5ooq")\;


## Dk.OpamBuild

Only the current OpamBuild revision ships. The retired Export@1.0.0-@1.0.15
ladder lives in pre-2026-08 release tags and git history (see dk.u
"## Assets" for the keep-latest-only policy).

  $ run-function CommonsLang_OCaml.Dk.OpamBuild.Export@1.0.33 -f ${RUNTIME}/OpamBuild.Export-1.0.33.zip
  \test(pass)
  \dk.object(abi: "Release.Darwin_arm64", value-id: "ofkhb4fn4p2mz32lrqhtbpisau6yyjvdxswq2y6scqwogdj2rqf5a")\;
